<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_wizard_form" model="ir.ui.view">
        <field name="name">jembatan.import.wizard.form</field>
        <field name="model">jembatan.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">
                    Unggah satu berkas dari folder <code>build/normalized/</code> hasil ETL.
                    Ikuti urutan di <code>docs/panduan-migrasi.md</code>.
                </p>
                <group>
                    <field name="entity"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="dry_run"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Jalankan" class="btn-primary"/>
                    <button special="cancel" string="Batal"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_wizard" model="ir.actions.act_window">
        <field name="name">Impor Berkas</field>
        <field name="res_model">jembatan.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
